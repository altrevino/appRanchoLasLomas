{
  "expo": {
    "name": "Las Lomas",
    "slug": "rancho-las-lomas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.rancholaslomas.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B3B30",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.rancholaslomas.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F6F2EA"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrarte en el mapa del rancho y detectar en qué espiadero estás durante el censo."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-dev-client"
    ],
    "scheme": "rancholaslomas",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
